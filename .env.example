# Copy to .env and set the passwords. .env is git-ignored; never commit it.
# Read by the backend's "dev" profile.
# Placeholder values for local development only.

# Local MySQL server.
CDSS_DB_HOST=localhost
CDSS_DB_PORT=3306
CDSS_DB_NAME=cdss
CDSS_DB_USERNAME=cdss_app
CDSS_DB_PASSWORD=change-me-local-dev-password

# Demo logins "admin" and "clinician" (8 to 72 characters each), created the
# first time the backend starts with these set. Left empty here on purpose:
# a user with an empty password is not created. Changing a value later does
# not change an existing user's password (see docs/DEMO.md).
CDSS_DEMO_ADMIN_PASSWORD=
CDSS_DEMO_CLINICIAN_PASSWORD=
