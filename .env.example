# Copy to .env and set CDSS_DB_PASSWORD. .env is git-ignored; never commit it.
# Read by the backend's "dev" profile to connect to your local MySQL server.
# Placeholder values for local development only.

CDSS_DB_HOST=localhost
CDSS_DB_PORT=3306
CDSS_DB_NAME=cdss
CDSS_DB_USERNAME=cdss_app
CDSS_DB_PASSWORD=change-me-local-dev-password
